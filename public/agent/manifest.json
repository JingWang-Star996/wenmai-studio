{
  "schemaVersion": "wenmai.agent-manifest/1.0-v5",
  "protocolVersion": "wenmai.agent/1.0",
  "status": "available",
  "runtimeApiStatus": "implemented",
  "discovery": "/.well-known/wenmai-agent.json",
  "apiContract": "/agent/api/v1.json",
  "systemPrompt": "/agent/prompts/system.md",
  "mcp": "/agent/mcp.json",
  "dataInterfaces": {
    "corpusClassificationAndLineage": "/api/corpus/v1?view=manifest",
    "dynamicCapabilities": "/api/capabilities",
    "articleProjectPackages": "/api/agent/v1?view=project_manifest",
    "projectGroups": "/api/agent/v1?view=project_group_manifest",
    "sharedSources": "/api/agent/v1?view=shared_source_manifest",
    "sharedArticles": "/api/agent/v1?view=articles"
  },
  "collaborationShare": {
    "schemaVersion": "wenmai.share-grant/1",
    "agentClientLifecycle": "reuses agent_clients Bearer, expiry and revoke lifecycle",
    "views": {"list": "/api/agent/v1?view=articles", "detail": "/api/agent/v1?view=article&articleId={authorizedArticleId}"},
    "profiles": {
      "viewer": {"scopes": ["article.read"], "articleIds": "exactly_one_existing_article", "taskIds": []},
      "editor": {"scopes": ["article.read", "task.read", "task.claim", "task.progress", "context.read", "artifact.create", "approval.request", "branch.agent_write"], "articleIds": "exactly_one_existing_article", "taskIds": "exactly_one_valid_non_terminal_Agent_Branch_task_of_that_article_revalidated_each_request", "writeBoundary": "Agent_Branch_candidate_only"}
    },
    "articleRevisionPolicy": "authoritative-current; unique active D1 Package primary Branch head wins, invalid D1 identity fails closed, otherwise operative corpus representative source",
    "lifetime": {"defaultDays": 7, "maximumDays": 30},
    "connectionCard": {"schemaVersion": "wenmai.share-grant/1", "containsSecret": false, "keyDelivery": "portable access file includes this connectionCard plus the separate Bearer credential; the credential never enters the card", "gatewayActivationImplied": false},
    "portableAccessFile": {"schemaVersion": "wenmai.agent-access-file/1", "kind": "portable-share-grant", "contents": ["existing wenmai.share-grant/1 connectionCard", "Bearer credential"], "secret": true, "possessionIsAuthority": true, "grantClasses": ["viewer", "editor"], "forbiddenCredentialClasses": ["advanced", "administrator"], "lifetime": {"viewerDefaultDays": 7, "editorUiDefaultDays": 1, "maximumDays": 30}, "holderAuthority": "corresponding Share Grant permissions apply until server-side expiry or revocation", "serverAuthority": "agent_clients status, expiry and revocation are authoritative", "credentialExposure": "never URL, argv, logs or connectionCard", "storage": {"treatLike": "SSH private key", "posixMode": "0600", "windowsDpapiImport": "optional existing CurrentUser import"}, "lossResponse": "revoke immediately by clientId", "gatewayActivationImplied": false, "crossDeviceOrPublicVerificationClaim": false},
    "cannot": ["main_write", "merge", "release", "publish", "token", "identity", "delete"],
    "crossDevice": {"transport": "Tailscale HTTPS", "gatewayMustBeSeparatelyEnabledAndVerified": true, "publicInternetDeploymentClaim": false}
  },
  "roleAccess": {
    "schemaVersion": "wenmai.role-grant/1",
    "agentClientLifecycle": "reuses agent_clients Bearer authentication, expiry and revoke lifecycle",
    "portableAccessFile": {"schemaVersion": "wenmai.agent-access-file/1", "kind": "portable-role-grant", "secret": true, "possessionIsAuthority": true, "credentialExposure": "never URL, argv or logs", "gatewayActivationImplied": false, "crossDeviceOrPublicVerificationClaim": false},
    "roles": {
      "content-steward": {"label": "文脉管家", "scopesExact": ["task.read", "context.read", "knowledge.read", "graph.read", "package.read", "shared_source.read", "task.manage"], "actionIdsExact": ["agent.v1.cancel_task", "agent.v1.create_task", "agent.v1.update_task"], "articleScope": "all_articles_including_future", "taskIds": [], "maximumLifetimeDays": 7, "transport": "local_or_exact_tailscale"},
      "article-worker": {"label": "文章工作员", "scopesExact": ["task.read", "task.claim", "task.progress", "context.read", "knowledge.read", "graph.read", "artifact.create", "approval.request", "graph.propose", "branch.agent_write", "package.read", "package.patch.propose"], "actionIdsExact": [], "articleScope": "all_articles_including_future", "taskIds": [], "maximumLifetimeDays": 7, "transport": "local_or_exact_tailscale", "graphProposeBoundary": "candidate graph or deduplication relation proposal only; never confirm, merge, delete or apply"},
      "local-registrar": {"label": "本机新文章建档员", "scopesExact": ["article.import.new_root"], "actionIdsExact": [], "articleScope": "all_articles_including_future", "taskIds": [], "maximumLifetimeDays": 1, "transport": "loopback_only", "boundary": "new root registration only; cannot list articles, read existing body text or overwrite; exact articleId plus bodySha256 may read back bounded registration status metadata"}
    },
    "developmentAndUpgrade": "local Git, worktree, tests and review only; never use a Bearer role grant",
    "currentGaps": ["no safe Agent write API for deduplication final merge", "no safe Agent write API for workflow fission new roots"],
    "forbidden": ["token.issue", "token.revoke", "identity", "approval.decide", "merge.apply", "release.approve", "publish", "send", "delete", "secret"]
  },
  "schemas": {
    "task": "/agent/schemas/task.schema.json",
    "context": "/agent/schemas/context.schema.json",
    "progress": "/agent/schemas/progress.schema.json",
    "artifact": "/agent/schemas/artifact.schema.json",
    "graphProposal": "/agent/schemas/graph-proposal.schema.json",
    "articleGuidanceChecklist": "/agent/schemas/article-guidance-checklist.schema.json"
  },
  "client": {
    "implementation": "scripts/wenmai_agent_client.py",
    "mode": "ndjson_stdio",
    "longRunningSubcommand": "worker",
    "requiresStdioCoordinator": true,
    "autonomousTaskPolling": false,
    "connectivitySubcommand": "status",
    "accessFileCommands": ["python -B scripts/wenmai_agent_client.py --access-file <path> status", "python -B scripts/wenmai_agent_client.py --access-file <path> worker"],
    "tokenEnvironment": "WENMAI_AGENT_TOKEN",
    "loopbackIpLiterals": ["127.0.0.1", "::1"],
    "transports": {
      "loopbackHttp": {
        "configuration": "--base-url <http-loopback-origin>",
        "defaultOrigin": "http://[::1]:3000"
      },
      "tailscaleHttps": {
        "configuration": "--trusted-tailscale-host <machine>.<tailnet>.ts.net",
        "hostnamePolicy": "exact_ascii_machine_tailnet_ts_net",
        "originConstruction": "https://<trusted-tailscale-host>",
        "defaultPort": 443,
        "gatewayAuthentication": "same_agent_bearer_required_for_agent_api_and_allowlisted_metadata",
        "tlsCertificateVerification": true,
        "tlsHostnameVerification": true
      }
    },
    "apiEndpoint": "/api/agent/v1",
    "sendsBrowserOrigin": false,
    "limits": {
      "timeoutSecondsDefault": 8,
      "timeoutSecondsMaximum": 60,
      "requestBytesDefault": 300000,
      "requestBytesMaximum": 2200000,
      "responseBytesDefault": 4194304,
      "responseBytesMaximum": 16777216,
      "stdinLineBytesDefault": 1048576,
      "stdinLineBytesMaximum": 16777216
    },
    "arbitraryShell": false,
    "arbitraryFileRead": false,
    "systemProxies": false,
    "redirects": false,
    "administratorActionBridge": {
      "command": "admin_action",
      "wrapperMode": "AdminAction",
      "actions": ["create_task", "update_task", "cancel_task"],
      "input": ["action", "payload", "commandId"],
      "stableCommandIdRequired": true,
      "issueOrRevokeKey": false,
      "loginOr2FA": false,
      "externalPublication": false
    },
    "superAdministratorActionBridge": {
      "command": "super_admin_action",
      "wrapperMode": "SuperAdminAction",
      "transport": "exact_http_ipv6_loopback_origin_only",
      "v3CurrentActions": ["create_task", "update_task", "cancel_task", "create_publication_branch", "save_working_copy", "commit_revision", "attach_branch", "register_publication_version"],
      "legacyFrozenOnlyActions": ["decide_approval", "decide_graph_proposal", "decide_patch", "apply_patch", "prepare_merge", "save_merge_resolution", "merge_revision", "consume_publish_capability"],
      "actionsMeaning": "The fixed bridge allowlist includes v3 current and legacy compatibility actions; authorization is the issued Key snapshot, never this client-side list.",
      "actions": [
        "create_task",
        "update_task",
        "cancel_task",
        "decide_approval",
        "decide_graph_proposal",
        "decide_patch",
        "apply_patch",
        "create_publication_branch",
        "attach_branch",
        "register_publication_version",
        "save_working_copy",
        "commit_revision",
        "prepare_merge",
        "save_merge_resolution",
        "merge_revision",
        "consume_publish_capability"
      ],
      "input": ["action", "payload", "commandId"],
      "stableCommandIdRequired": true,
      "arbitraryPathOrAction": false,
      "issueOrRevokeKey": false,
      "issuePublishCapability": false,
      "loginOr2FA": false,
      "externalPublicationClick": false
    },
    "siteFullControlExchange": {
      "action": "auth.site_full_control.exchange",
      "keyPurpose": "site_full_control",
      "directAgentApi": true,
      "transport": "exact_http_ipv6_loopback_origin_only",
      "keyDelivery": "one_time_display_then_Authorization_header_only; never_url_body_storage_log_or_receipt",
      "derivedSession": "host_only_HttpOnly_SameSite_Strict_cookie; fixed_commandId; browser_header_and_body_sha256_binding",
      "revocation": "new_exchange_revokes_prior_derived_session; key_revoke_expiry_or_snapshot_drift_invalidates_derived_session",
      "boundaries": ["no_runner_or_tailscale", "no_trusted_device_enrollment", "no_login_password_captcha_2fa_account_switch_or_external_publish_click", "publish_capability_and_publication_claims_remain_separate"]
    },
    "arbitrarySuperAdminRequestBridge": false
  },
  "privilegedRoles": {
    "issuer": "owner browser management session only",
    "legacyFrozenProfiles": "The fixed wildcard profiles below describe compatibility-only legacy Keys. They are not the v3 default or a current issuance offer.",
    "v3CurrentIssuance": {
      "catalogEndpoint": "GET /api/agent/v1?view=permission_catalog",
      "authentication": "owner browser management session only; an Authorization Bearer header is rejected",
      "schemaVersion": "wenmai.agent-permission-catalog/3",
      "catalogVersionSource": "server-returned catalogVersion at issuance time",
      "catalogDigest": "Catalog GET returns catalogSha256, the canonical SHA-256 of the complete catalog plus presets; it is not a client-chosen value.",
      "presets": ["read_admin", "task_admin", "content_editor_admin", "release_prep_admin", "site_full_control", "custom"],
      "selectionRule": "Only scopes with delegable=true and newIssuance=true may be selected; the server repeats the authority check.",
      "objectBoundary": "articleIds is a sorted set of 1..200 known concrete IDs, never '*'; taskIds is [].",
      "role": "Derived by the server from the selected scopes, never trusted from the client.",
      "snapshot": "The issued Key records immutable actionIds, catalogVersion and a permission snapshot SHA-256. Later catalog changes neither expand nor invalidate that Key.",
      "issuanceConfirmation": "v3 issue must echo catalogVersion, catalogSha256 and sorted, deduplicated confirmedActionIds. The server recomputes the catalog digest and the exact scopes-to-actions set before signing; read-only presets validly use confirmedActionIds=[].",
      "legacyV3WithoutDigest": "A v3 snapshot without catalogSha256 is compatibility-only and never gains permissions from a later catalog.",
      "currentScopes": ["task.read", "context.read", "knowledge.read", "graph.read", "package.read", "task.manage", "workspace.branch.write", "workspace.publication_branch.create", "package.branch.attach", "publication.version.register"],
      "taskManage": {"actionIds": ["agent.v1.create_task", "agent.v1.update_task", "agent.v1.cancel_task"], "agentBranchCreation": "create_task may create a task-owned Agent Branch, initial Revision and WorkingCopy only when branch.agent_write is explicitly requested; it cannot write main or create a publication branch"},
      "workspaceBranchWrite": {"role": "super_admin", "transport": "exact [::1] loopback only", "route": "/api/workspace", "actionIds": ["workspace.save_working_copy", "workspace.commit_revision"], "wireActions": ["save_working_copy", "commit_revision"], "stableCommandIdAndCasReceiptRequired": true},
      "stagedHighRiskScopes": ["package.working_copy.save", "package.revision.commit", "approval.decide", "graph.decide", "package.patch.decide", "package.patch.apply", "workspace.merge.prepare", "workspace.merge.resolve", "workspace.merge.apply", "publish.capability.consume"],
      "stagedHighRiskIssuance": {"authorized": false, "delegable": false, "newIssuance": false, "meaning": "visible staged high-risk catalog entries; a consume receipt is not an external publication result"}
    },
    "administrator": {
      "role": "administrator",
      "scopes": ["task.read", "context.read", "knowledge.read", "graph.read", "package.read", "task.manage"],
      "articleIds": ["*"],
      "taskIds": [],
      "maximumLifetimeDays": 30,
      "transports": ["loopback", "tailscale"]
    },
    "superAdmin": {
      "legacyFrozenProfile": true,
      "role": "super_admin",
      "scopes": ["task.read", "context.read", "knowledge.read", "graph.read", "package.read", "task.manage", "approval.decide", "graph.decide", "package.patch.decide", "package.patch.apply", "workspace.publication_branch.create", "package.branch.attach", "publication.version.register", "workspace.merge.prepare", "workspace.merge.resolve", "workspace.merge.apply", "publish.capability.consume"],
      "articleIds": ["*"],
      "taskIds": [],
      "maximumLifetimeDays": 7,
      "transport": "exact [::1] loopback only",
      "tailscale": false,
      "actions": ["create_task", "update_task", "cancel_task", "decide_approval", "decide_graph_proposal", "decide_patch", "apply_patch", "create_publication_branch", "attach_branch", "register_publication_version", "prepare_merge", "save_merge_resolution", "merge_revision", "consume_publish_capability"],
      "cannot": ["generic_create_branch", "save_working_package", "commit", "set_primary_branch", "issue_or_revoke_key", "issue_publish_capability", "login_or_2FA", "switch_account", "click_external_publish", "claim_completion_or_public_visibility"]
    },
    "siteFullControl": {
      "catalogVersion": "2026-09-10.1",
      "exclusiveScope": "site.full_control",
      "role": "super_admin",
      "articleIds": ["*"],
      "includesFutureArticles": true,
      "taskIds": [],
      "maximumLifetimeDays": 7,
      "actionIds": ["auth.site_full_control.direct", "auth.site_full_control.exchange"],
      "permissionSnapshotStorageSchemaVersion": 3,
      "rootPermissionSnapshotDocumentSchemaVersion": 5,
      "managementProjectionVersion": "wenmai.site-full-control-management-projection/v5",
      "managementScopes": ["management.read", "editorial.write", "identity.decide", "workspace.branch.write", "workspace.revision.commit", "workspace.merge.apply", "capability.override", "lifecycle.write", "release.approve", "release.record", "rule.adopt", "package.write", "package.patch.decide", "token.issue", "token.revoke", "task.manage", "runner.manage", "admin.diagnostics"],
      "unknownManagementCatalogScope": "fail_closed",
      "directAgentApi": true,
      "legacyV4RootKey": "exchange_only_reissue_required"
    },
    "keyStorage": "DPAPI CurrentUser named profile; no plaintext Key in generated commands",
    "publishCapabilityConsumeMeaning": "CAS consumption only; all external publication and completion claims remain false",
    "publicationBranchPipeline": {
      "actions": ["create_publication_branch", "attach_branch", "register_publication_version"],
      "scopes": ["workspace.publication_branch.create", "package.branch.attach", "publication.version.register"],
      "stableCommandIdRequiredForEveryAction": true,
      "casAndPersistedReceiptRequiredForEveryAction": true,
      "sourceBoundary": "create_publication_branch copies only the current clean primary/canonical Package coordinates bound by Package, branch, Revision, body and Composition CAS",
      "historicalContentFlow": "worker proposes a branch-qualified candidate Patch, then a legacy local super_admin Key may decide and apply that Patch before registration; decide/apply are not v3 current issuance",
      "genericWorkspaceOrPackageWritesExposed": false,
      "externalPublication": false
    }
  },
  "mcpServer": {
    "status": "available",
    "implementation": "scripts/wenmai_mcp_server.py",
    "transport": "stdio_newline_delimited_json_rpc",
    "protocolVersion": "2025-06-18",
    "toolDiscovery": "tools/list",
    "resourceDiscovery": "resources/list",
    "promptDiscovery": "prompts/list",
    "tokenEnvironment": "WENMAI_AGENT_TOKEN",
    "objectScopeInheritedFromAgentClient": true,
    "packageReadScope": "package.read",
    "packageReadAuthentication": "agent_bearer_only",
    "projectGroupReadAuthentication": "agent_bearer_plus_package.read_complete_group_scope",
    "projectGroupReadTools": ["wenmai_list_project_groups", "wenmai_get_project_group"],
    "projectGroupWriteTools": [],
    "projectGroupListProjection": {"boundedSummary": true, "excludes": ["members", "edges", "topology", "integrityStatus"], "detailRequiredForTopology": true},
    "projectGroupDetailReadLimits": {"members": 256, "edges": 2048, "exceeded": "PROJECT_GROUP_READ_LIMIT_EXCEEDED", "status": 409, "partialDataReturned": false},
    "projectGroupEmptyGroupScope": "star-visible; restricted list omitted and detail 403 without disclosure",
    "projectGroupReadSideEffects": {"projectGroupBusinessWrites": false, "tablesEventsReceiptsUnchanged": true, "authenticationLastSeenTelemetryMayUpdate": true},
    "sharedSourceReadAuthentication": "agent_bearer_plus_shared_source.read_source_binding_rights_access_gate",
    "sharedSourceReadViews": ["shared_source_manifest", "shared_source"],
    "sharedSourceReadTools": [],
    "sharedSourceReadProjection": {"metadataOnly": true, "currentCapability": "metadata_projection_only", "excludes": ["body", "excerpt", "content_ref", "raw_provider_ids"], "connector": "unconfigured", "library": "unconfigured", "import": "unavailable"},
    "sharedSourceReadSideEffects": {"sharedSourceBusinessWrites": false, "authenticationLastSeenTelemetryMayUpdate": true},
    "managementCookieOrBrowserBindingUsed": false,
    "branchQualifiedPackageTools": [
      "wenmai_get_article_project",
      "wenmai_get_project_diagnostics",
      "wenmai_get_project_slices",
      "wenmai_propose_package_patch"
    ],
    "packageBranchDiscoveryTool": "wenmai_list_project_branches",
    "packagePatchTargetModule": "coordinator-frozen contextSpec.targetModuleKey; one existing module per task; incident edges only",
    "packagePatchAllowedOperations": ["replace_module", "remove_module", "upsert_edge", "remove_edge"],
    "taskDetailContextBundleReturned": false,
    "mainBranchWrite": false,
    "approvalOrPublication": false
  },
  "commands": [
    "help",
    "manifest",
    "status",
    "list_tasks",
    "get_task",
    "get_context",
    "search_knowledge",
    "get_subgraph",
    "claim",
    "heartbeat",
    "progress",
    "add_artifact",
    "propose_revision",
    "propose_package_patch",
    "await_human",
    "complete",
    "fail",
    "release",
    "admin_action",
    "super_admin_action"
  ],
  "clientScopes": {
    "package.read": "read-only Package projections constrained by token articleIds and explicit branchId",
    "shared_source.read": "read-only metadata-only SharedSource projections, allowed only when source, current binding, rights and access gates all pass; never returns body, excerpt, content_ref or raw provider IDs",
    "package.patch.propose": "leased candidate Patch proposal for one coordinator-frozen existing targetModuleKey; replace_module/remove_module and incident upsert_edge/remove_edge only; never apply, merge or advance a branch",
    "task.manage": "administrator or local-only super_admin may create, update, and cancel tasks with a stable commandId",
    "workspace.publication_branch.create": "local-only super_admin may create an isolated platform branch only from the current clean primary/canonical Package coordinates with full CAS and a persisted receipt",
    "package.branch.attach": "local-only super_admin may attach that existing clean ArticleBranch to its ArticleProject Package with branch-head and working-copy CAS; no generic branch creation or source advancement",
    "publication.version.register": "local-only super_admin may register an exact clean in-sync Composition as the current PublicationVersion with branch, Revision, body, Composition, target, canonical-baseline and registry CAS",
    "publish.capability.consume": "local-only super_admin may consume an owner-issued opaque one-use capability; this is never an external publish result"
  },
  "taskStates": [
    "draft",
    "queued",
    "claimed",
    "running",
    "awaiting_human",
    "blocked",
    "review",
    "succeeded",
    "failed",
    "cancelled"
  ],
  "claims": [
    "artifact_created",
    "artifact_validated",
    "submission_accepted",
    "destination_record_verified",
    "private_access_verified",
    "public_access_verified",
    "outcome_verified"
  ],
  "safety": {
    "singleAgentBaseline": true,
    "humanApprovalRequiredForExternalEffects": true,
    "artifactStatusDefault": "draft",
    "graphProposalStatusDefault": "suggested",
    "completionDoesNotImplyPublication": true,
    "packagePatchCandidateOnly": true,
    "packagePatchCompleteAllowedForAgent": false,
    "packagePatchCompletionAuthority": "coordinator_only",
    "packageContextBranchScoped": true,
    "packagePatchSingleExistingModuleOnly": true,
    "packagePatchIncidentEdgesOnly": true,
    "packagePatchReplaceDocument": false,
    "packagePatchAddModule": false,
    "taskDetailRedactsFrozenBundle": true,
    "releaseMeansLeaseReleaseOnly": true,
    "secretLoggingForbidden": true,
    "ownerSignsKeysAndPublishCapabilities": true,
    "publishCapabilityConsumptionIsPublication": false,
    "privilegedRoleProfilesExact": true
  }
}
