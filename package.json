{
  "name": "wenmai-local-article-studio",
  "version": "0.2.0",
  "description": "Local-first article engineering workbench with bounded Agent and MCP access.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "copy:audit": "node scripts/export-interface-copy.mjs",
    "data:bootstrap": "node scripts/bootstrap-public-data.mjs",
    "data:capabilities:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-capabilities.ps1",
    "predev": "npm run data:bootstrap",
    "dev": "node scripts/run-vinext.mjs dev",
    "prebuild": "npm run data:bootstrap",
    "build": "node scripts/run-vinext.mjs build",
    "prestart": "npm run data:bootstrap",
    "start": "node scripts/run-vinext.mjs start",
    "test": "npm run test:public",
    "test:public": "npm run test:public-release && npm run test:public-data && npm run build && npm run test:agent-access && npm run test:local-import && npm run test:agent-client && npm run test:mcp && npm run test:vnext",
    "test:public-release": "python -B -m unittest tests/test_stage_public_release_candidate.py && node --test tests/public-release-privacy.test.mjs",
    "test:public-data": "node --test tests/public-data-bootstrap.test.mjs",
    "test:management-auth": "npm run build && npm run test:management-auth:built",
    "test:management-auth:built": "node --experimental-strip-types --test tests/management-auth-core.test.mjs && node --test tests/management-auth-contract.test.mjs tests/management-auth-integration.test.mjs tests/management-device-browser-contract.test.mjs",
    "test:local-import": "node --experimental-strip-types --test tests/local-import-auth-core.test.mjs tests/article-archive-intake.test.mjs tests/local-import-access-file-interop.test.mjs && node --test tests/local-import-contract.test.mjs tests/local-import-credential-windows.test.mjs",
    "test:agent-access": "node --experimental-strip-types --test tests/agent-admin-role-contract.test.mjs tests/publish-capability-core.test.mjs tests/collaboration-access.test.mjs tests/portable-agent-access.test.mjs && node --test tests/agent-access-hardening.test.mjs tests/agent-profile-windows.test.mjs tests/privileged-agent-routing-contract.test.mjs",
    "test:model-routing": "node --experimental-strip-types --test tests/model-routing.test.mjs tests/codex-native-smoke-contract.test.mjs && node --test tests/model-routing-contract.test.mjs tests/codex-native-agent-profile.test.mjs tests/release-execution-contract.test.mjs tests/model-routing-ui-contract.test.mjs tests/model-provider-integration-contract.test.mjs tests/start-wenmai-env-contract.test.mjs",
    "test:cmf-consistency": "node --test tests/cmf-content-consistency-contract.test.mjs",
    "test:release-control-v2": "node --experimental-strip-types --test tests/release-control-v2-core.test.mjs tests/release-control-v2-management-contract.test.mjs tests/release-control-v2-management-smoke.test.mjs tests/release-control-v2-capability-issuance-contract.test.mjs tests/release-control-v2-host-contract.test.mjs tests/release-control-v2-host-integration.test.mjs tests/release-control-v2-schema-migration.test.mjs tests/release-control-v2-worker-bindings.test.mjs tests/release-control-v2-ui-contract.test.mjs",
    "test:codex-native": "node --experimental-strip-types --test tests/codex-native-smoke-contract.test.mjs && node --test tests/codex-native-agent-profile.test.mjs",
    "codex-native:prepare": "node --experimental-strip-types scripts/codex-native-smoke.mjs prepare",
    "test:privileged-access:built": "node --test tests/agent-administrator-api-integration.test.mjs tests/agent-super-admin-api-integration.test.mjs tests/privileged-agent-routes-integration.test.mjs tests/publish-capability-integration.test.mjs",
    "test:meta-improvement": "npm run build && npm run test:meta-improvement:built",
    "test:meta-improvement:built": "node --test tests/model-gateway-contract.test.mjs tests/model-invocation-checkpoint-contract.test.mjs tests/model-invocation-output-checkpoint-contract.test.mjs tests/meta-improvement-budget.test.mjs tests/meta-improvement-domain.test.mjs tests/meta-improvement-lab-contract.test.mjs tests/meta-improvement-contract.test.mjs tests/meta-improvement-route-integration.test.mjs tests/meta-improvement-provider-migration.test.mjs",
    "test:article-identity": "npm run build && npm run test:article-identity:built",
    "test:annotation-rsi": "npm run build && npm run test:annotation-rsi:built",
    "test:annotation-rsi:built": "node --experimental-strip-types --test tests/annotation-rsi-domain.test.mjs tests/annotation-rsi-schema-migration.test.mjs tests/annotation-rsi-route-integration.test.mjs tests/annotation-rsi-summary-ui.test.mjs",
    "test:article-identity:built": "node --test tests/article-identity-contract.test.mjs tests/article-identity-migration.test.mjs tests/article-identity-route-integration.test.mjs",
    "test:article-lineage-ai": "npm run build && npm run test:article-lineage-ai:built",
    "test:article-lineage-ai:built": "node --experimental-strip-types --test tests/article-lineage-ai-contract.test.mjs tests/article-lineage-ai-migration.test.mjs",
    "test:project-groups": "node --experimental-strip-types --test tests/project-group-domain.test.mjs tests/project-group-migration.test.mjs tests/project-group-route-integration.test.mjs tests/project-group-agent-read-integration.test.mjs tests/project-group-ui-contract.test.mjs",
    "test:shared-sources": "node --experimental-strip-types --test tests/shared-source-domain.test.mjs tests/shared-source-route-integration.test.mjs tests/shared-source-schema-migration.test.mjs tests/shared-source-ui-contract.test.mjs",
    "test:vnext": "npm run test:project-groups && npm run test:shared-sources && node --experimental-strip-types --test tests/agent-permission-snapshot-integration.test.mjs tests/agent-permission-snapshot-migration.test.mjs tests/high-risk-decision-separation.test.mjs tests/corpus-detail-route-integration.test.mjs tests/reader-ui-hardening.test.mjs",
    "test:import-profile": "node --experimental-strip-types --test tests/import-profile-recommendation.test.mjs",
    "test:platform-targets": "node --experimental-strip-types --test tests/article-platform-target-contract.test.mjs tests/article-publication-version.test.mjs tests/bilibili-article-contract.test.mjs tests/maimai-platform-contract.test.mjs tests/maimai-release-flow.test.mjs tests/video-release-contract.test.mjs",
    "test:maimai-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-maimai-release-tests.ps1",
    "test:runner": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-runner-tests.ps1",
    "test:agent-client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-agent-client-tests.ps1",
    "test:mcp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-mcp-tests.ps1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
